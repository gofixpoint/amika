{
  "name": "@amika/iroh-rules",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && tsc --noEmit -p tsconfig.workers.json",
    "format": "prettier --write .",
    "formatcheck": "prettier --check .",
    "test": "vitest run",
    "update-test-vectors": "UPDATE_TEST_VECTORS=1 vitest run src/test-vectors.test.ts && prettier --write test-vectors.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^16.4.0",
    "prettier": "3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
