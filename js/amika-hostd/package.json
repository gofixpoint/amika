{
  "name": "@amika/hostd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "amika-hostd": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js up --fg",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "formatcheck": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.5",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^16.4.0",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
