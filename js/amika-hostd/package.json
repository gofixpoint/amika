{
  "name": "@amika/hostd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "amika-hostd": "dist/bundle/amika-hostd.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "build": "node scripts/bundle.mjs",
    "start": "node dist/bundle/amika-hostd.mjs up --fg",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "formatcheck": "prettier --check ."
  },
  "dependencies": {
    "@amika/sandbox": "workspace:*",
    "@amika/service-auth": "workspace:*",
    "@hono/node-server": "1.19.15",
    "@libp2p/interface": "3.3.1",
    "@libp2p/logger": "6.2.14",
    "@libp2p/utils": "7.4.2",
    "@libp2p/yamux": "8.0.4",
    "hono": "4.13.11",
    "smol-toml": "1.9.0",
    "smolmachines": "1.22.2",
    "uint8arraylist": "3.0.2",
    "ws": "8.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "globals": "^16.4.0",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
