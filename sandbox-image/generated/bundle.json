    "setup_hooks": [
      "/usr/local/etc/amikad/setup/setup.sh",
      "/usr/local/etc/amikad/setup/start.sh"
    ],
    "standard_path": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "workspace": "/home/amika/workspace"
