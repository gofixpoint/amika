UBUNTU_TAG=24.04
# Floor, not a pin: os-packages installs the newest candidate and fails the
# build below this. USN-8944-1 removes emSign ECC Root CA - G3 after the
# October 2026 eMudhra intermediate compromise (KAPRO-1060).
CA_CERTIFICATES_MIN_VERSION=20260816ubuntu0.24.04.1
NODE_VERSION=24.22.1
# Replaces the npm bundled with Node, whose own dependencies (undici,
# brace-expansion, http-cache-semantics) carry advisories fixed in 11.21.1.
NPM_VERSION=11.21.1
PNPM_VERSION=12.14.0
TYPESCRIPT_VERSION=7.0.2
TSX_VERSION=4.23.13
GH_VERSION=2.102.1
GIT_VERSION=2.54.0
DOCKER_VERSION=29.9.2
BUILDX_VERSION=0.38.1
CLAUDE_CODE_VERSION=2.1.309
CODEX_VERSION=0.164.0
OPENCODE_VERSION=1.19.4
PI_VERSION=1.3.0
PI_WEB_VERSION=0.12.2
# TODO(KAPRO-1060, KAPRO-1058): bump amika, amikalog and amikad to releases
# rebuilt with Go >= 1.26.10 (GO-2026-6809 x509 distrust) once they exist.
AMIKA_VERSION=0.22.0
AMIKALOG_VERSION=0.2.0
AMIKAD_VERSION=0.2.0
